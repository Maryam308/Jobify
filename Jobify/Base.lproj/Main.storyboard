        <!--Privacy Policy Agreement-->
        <scene sceneID="HIa-ya-iyw">
            <objects>
                <viewController title="Privacy Policy Agreement" id="6wH-nm-JcS" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="QmO-mI-Q3E">
                        <rect key="frame" x="0.0" y="0.0" width="440" height="946"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <textView clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="scaleToFill" minimumZoomScale="5" editable="NO" textAlignment="natural" selectable="NO" translatesAutoresizingMaskIntoConstraints="NO" id="QKT-JW-Ypo">
                                <rect key="frame" x="42" y="28" width="357" height="746"/>
                                <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                                <constraints>
                                    <constraint firstAttribute="height" constant="746" id="oGi-zU-Ns6"/>
                                </constraints>
                                <string key="text">Q1. How to delete my account? 
To delete your account, follow these steps:

	1. Open the side menu (☰) at the top of 	the home page.

	2. Click on Settings to go to the 			settings screen.

	3. In the settings screen, select 			Account to access the Account 			Settings.

	4. Click on Delete Your Account and 		Data. 

	5. When the alert appears, confirm by 		clicking Delete.

Q2.  How can I change my password ?

	1. Go to Side Menu. 
	2. Click on Settings.
	3. Click onSign in &amp; Security.
	4. Click onChange Password.
	5. You will be directed to another 			screen to reset your password.

Q3.  How can I log-out ?

	1. From the home screen click on the 		side menue icon (☰).
	2. Click on logout button.

From Profile Screen:
	1. Click on the settings icon.</string>
                                <color key="textColor" systemColor="labelColor"/>
                                <fontDescription key="fontDescription" type="system" pointSize="18"/>
                                <textInputTraits key="textInputTraits" autocapitalizationType="sentences"/>
                            </textView>
                        </subviews>
