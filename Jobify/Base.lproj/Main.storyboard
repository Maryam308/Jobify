        <!--Privacy Policy Agreement-->
        <scene sceneID="Anm-sw-lx2">
            <objects>
                <viewController title="Privacy Policy Agreement" id="CLD-7x-llu" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="K31-UA-0uD">
                        <rect key="frame" x="0.0" y="0.0" width="440" height="946"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <textView clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="scaleToFill" editable="NO" textAlignment="natural" selectable="NO" translatesAutoresizingMaskIntoConstraints="NO" id="yTV-mT-fPJ">
                                <rect key="frame" x="42" y="42" width="357" height="743"/>
                                <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                                <constraints>
                                    <constraint firstAttribute="height" constant="743" id="ArK-Vy-C1I"/>
                                </constraints>
                                <string key="text">We respect your privacy and are committed to protecting your personal data. This Privacy Policy describes how we collect, use, and share your information in compliance with Bahrain's Personal Data Protection Law (PDPL).

1.Data Collection We collect personal information only as necessary to provide our services. This may include your name, contact information, and other details relevant to your account or application usage.

2.Purpose of Data Collection We process your data to provide and enhance our services, ensure compliance with legal obligations, and improve user experience.

3.Third-Party Sharing We do not share your personal information with third parties except as necessary to comply with legal obligations or to provide our service. 

4. User Rights
Under PDPL, you have the right to access, correct, and request the deletion of your personal information, subject to certain limitations. Contact us to exercise these rights.</string>
                                <color key="textColor" systemColor="labelColor"/>
                                <fontDescription key="fontDescription" type="system" pointSize="18"/>
                                <textInputTraits key="textInputTraits" autocapitalizationType="sentences"/>
                            </textView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="4x3-Nb-Hx6"/>
                        <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                        <constraints>
                            <constraint firstItem="4x3-Nb-Hx6" firstAttribute="trailing" secondItem="yTV-mT-fPJ" secondAttribute="trailing" constant="41" id="1Bq-eo-rh0"/>
                            <constraint firstItem="yTV-mT-fPJ" firstAttribute="leading" secondItem="4x3-Nb-Hx6" secondAttribute="leading" constant="42" id="QBX-0N-YPS"/>
                            <constraint firstItem="yTV-mT-fPJ" firstAttribute="top" secondItem="4x3-Nb-Hx6" secondAttribute="top" constant="42" id="UdD-6S-w53"/>
                        </constraints>
                    </view>
                    <navigationItem key="navigationItem" id="oZL-I2-efK"/>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="ojb-yM-8h0" userLabel="First Responder" customClass="UIResponder" sceneMemberID="firstResponder"/>
            </objects>
